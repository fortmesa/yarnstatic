{
  "name": "@fortmesa/yarnstatic",
  "version": "1.1.2",
  "description": "Node.js CLI port of yarnstatic (check/fetch/serve/version) -- an alternative to the Go binary for environments with Node but not Go. Bundles yarn-plugin-yarnstatic-s3 for direct-S3 installs with no daemon.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fortmesa/yarnstatic.git",
    "directory": "cli-node"
  },
  "homepage": "https://github.com/fortmesa/yarnstatic/tree/main/cli-node#readme",
  "keywords": [
    "yarn",
    "yarn-berry",
    "verdaccio",
    "npm-registry",
    "s3",
    "offline-install"
  ],
  "bin": "./bin/yarnstatic.js",
  "main": "src/main.js",
  "packageManager": "yarn@4.18.1+sha512.b2e1e7524f654f2749d32b4ebcb4622473cb5bcbc485df2007e12a154e50162a4d795526768bc5f5b8f81717bfd79deb2472813d86fb5ae2eb551fa9c872b08f",
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "bin",
    "src",
    "plugin/plugin-yarnstatic-s3.cjs",
    "README.md"
  ],
  "scripts": {
    "prepack": "node scripts/build-plugin-bundle.js",
    "test": "node test/smoke.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1153.0",
    "@aws-sdk/credential-providers": "^3.1153.0",
    "yaml": "^2.9.1"
  }
}
